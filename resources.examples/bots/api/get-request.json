{
    "authentication": {
        "token": "",
        "password": "",
        "username": ""
    },
    "driverParameters": {
        "driver": "NoDriver",
        "driverBinaries": "."
    },
    "reference": {
        "description": "Reads an item from a web API with a GET request, picks fields out of the JSON answer with ReadJson, and asserts them. No browser is needed.",
        "name": "GET Request"
    },
    "settings": {
        "automationSettings": {
            "loadTimeout": 60000,
            "maxParallel": 1,
            "returnStructuredResponse": true,
            "searchTimeout": 15000
        },
        "environmentSettings": {
            "defaultEnvironment": "SystemParameters",
            "returnEnvironment": true
        },
        "screenshotsSettings": {
            "outputFolder": ".",
            "convertToBase64": true,
            "returnScreenshots": true,
            "onExceptionOnly": false
        },
        "pluginsSettings": {
            "externalRepositories": [],
            "servers": {}
        },
        "exceptionsSettings": {
            "returnExceptions": true
        }
    },
    "stages": [
        {
            "reference": {
                "description": "GET asks the API for an item without changing anything.",
                "name": "Read an item"
            },
            "jobs": [
                {
                    "reference": {
                        "description": "The answer is kept in session parameters: the status code and the body.",
                        "name": "Send the request"
                    },
                    "rules": [
                        {
                            "$type": "Action",
                            "pluginName": "SendHttpRequest",
                            "capabilities": {
                                "displayName": "GET post 1"
                            },
                            "argument": "{{$ --Url:https://jsonplaceholder.typicode.com/posts/1 --Method:Get}}"
                        },
                        {
                            "$type": "Action",
                            "pluginName": "Assert",
                            "capabilities": {
                                "displayName": "The status is 200 (OK)"
                            },
                            "argument": "{{$ --Condition:Text --Operator:Equal --Expected:200}}",
                            "onElement": "{{$Get-Parameter --Name:SendHttpRequest:HttpStatusCode --Scope:Session}}"
                        }
                    ]
                },
                {
                    "reference": {
                        "description": "ReadJson takes a JSON text and a path; its result is the session parameter ReadJson:Result.",
                        "name": "Read fields of the answer"
                    },
                    "rules": [
                        {
                            "$type": "Action",
                            "pluginName": "ReadJson",
                            "capabilities": {
                                "displayName": "Read the id"
                            },
                            "argument": "{{$Get-Parameter --Name:SendHttpRequest:HttpResponse --Scope:Session}}",
                            "onElement": "$.id",
                            "regularExpression": "(?s).*"
                        },
                        {
                            "$type": "Action",
                            "pluginName": "Assert",
                            "capabilities": {
                                "displayName": "The id is 1"
                            },
                            "argument": "{{$ --Condition:Text --Operator:Equal --Expected:1}}",
                            "onElement": "{{$Get-Parameter --Name:ReadJson:Result --Scope:Session}}"
                        },
                        {
                            "$type": "Action",
                            "pluginName": "ReadJson",
                            "capabilities": {
                                "displayName": "Read the title"
                            },
                            "argument": "{{$Get-Parameter --Name:SendHttpRequest:HttpResponse --Scope:Session}}",
                            "onElement": "$.title",
                            "regularExpression": "(?s).*"
                        },
                        {
                            "$type": "Action",
                            "pluginName": "Assert",
                            "capabilities": {
                                "displayName": "The title has text"
                            },
                            "argument": "{{$ --Condition:Text --Operator:Match --Expected:\\S+}}",
                            "onElement": "{{$Get-Parameter --Name:ReadJson:Result --Scope:Session}}"
                        },
                        {
                            "$type": "Action",
                            "pluginName": "WriteLog",
                            "capabilities": {
                                "displayName": "Log the title"
                            },
                            "argument": "Post 1 is titled: {{$Get-Parameter --Name:ReadJson:Result --Scope:Session}}"
                        }
                    ]
                }
            ]
        }
    ]
}
