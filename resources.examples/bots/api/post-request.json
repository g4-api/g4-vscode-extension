{
    "authentication": {
        "token": "",
        "password": "",
        "username": ""
    },
    "driverParameters": {
        "driver": "NoDriver",
        "driverBinaries": "."
    },
    "reference": {
        "description": "Creates an item on a web API with a POST request that carries a JSON body, then asserts the status and the item the API sends back. No browser is needed. The practice API answers as if it saved the item.",
        "name": "POST Request"
    },
    "settings": {
        "automationSettings": {
            "loadTimeout": 60000,
            "maxParallel": 1,
            "returnStructuredResponse": true,
            "searchTimeout": 15000
        },
        "environmentSettings": {
            "defaultEnvironment": "SystemParameters",
            "returnEnvironment": true
        },
        "screenshotsSettings": {
            "outputFolder": ".",
            "convertToBase64": true,
            "returnScreenshots": true,
            "onExceptionOnly": false
        },
        "pluginsSettings": {
            "externalRepositories": [],
            "servers": {}
        },
        "exceptionsSettings": {
            "returnExceptions": true
        }
    },
    "stages": [
        {
            "reference": {
                "description": "POST sends a new item to the API.",
                "name": "Create an item"
            },
            "jobs": [
                {
                    "reference": {
                        "description": "--Body is the text to send and --ContentType says it is JSON.",
                        "name": "Send the request"
                    },
                    "rules": [
                        {
                            "$type": "Action",
                            "pluginName": "SendHttpRequest",
                            "capabilities": {
                                "displayName": "POST a new post"
                            },
                            "argument": "{{$ --Url:https://jsonplaceholder.typicode.com/posts --Method:Post --ContentType:application/json --Body:{\"title\":\"Example post\",\"body\":\"Created by a bot\",\"userId\":1}}}"
                        },
                        {
                            "$type": "Action",
                            "pluginName": "Assert",
                            "capabilities": {
                                "displayName": "The status is 201 (Created)"
                            },
                            "argument": "{{$ --Condition:Text --Operator:Equal --Expected:201}}",
                            "onElement": "{{$Get-Parameter --Name:SendHttpRequest:HttpStatusCode --Scope:Session}}"
                        }
                    ]
                },
                {
                    "reference": {
                        "description": "The API sends the item back, with the id it gave it.",
                        "name": "Assert the created item"
                    },
                    "rules": [
                        {
                            "$type": "Action",
                            "pluginName": "ReadJson",
                            "capabilities": {
                                "displayName": "Read the title"
                            },
                            "argument": "{{$Get-Parameter --Name:SendHttpRequest:HttpResponse --Scope:Session}}",
                            "onElement": "$.title",
                            "regularExpression": "(?s).*"
                        },
                        {
                            "$type": "Action",
                            "pluginName": "Assert",
                            "capabilities": {
                                "displayName": "The title is the one sent"
                            },
                            "argument": "{{$ --Condition:Text --Operator:Equal --Expected:Example post}}",
                            "onElement": "{{$Get-Parameter --Name:ReadJson:Result --Scope:Session}}"
                        },
                        {
                            "$type": "Action",
                            "pluginName": "ReadJson",
                            "capabilities": {
                                "displayName": "Read the new id"
                            },
                            "argument": "{{$Get-Parameter --Name:SendHttpRequest:HttpResponse --Scope:Session}}",
                            "onElement": "$.id",
                            "regularExpression": "(?s).*"
                        },
                        {
                            "$type": "Action",
                            "pluginName": "Assert",
                            "capabilities": {
                                "displayName": "The item got an id"
                            },
                            "argument": "{{$ --Condition:Text --Operator:Match --Expected:^\\d+$}}",
                            "onElement": "{{$Get-Parameter --Name:ReadJson:Result --Scope:Session}}"
                        },
                        {
                            "$type": "Action",
                            "pluginName": "WriteLog",
                            "capabilities": {
                                "displayName": "Log the new id"
                            },
                            "argument": "The API created post {{$Get-Parameter --Name:ReadJson:Result --Scope:Session}}."
                        }
                    ]
                }
            ]
        }
    ]
}
