{
    "name": "g4-engine-client",
    "displayName": "%displayName%",
    "description": "%description%",
    "version": "0.0.2",
    "icon": "resources.assets/icon.png",
    "engines": {
        "vscode": "^1.105.0"
    },
    "publisher": "g4-api",
    "repository": {
        "type": "git",
        "url": "https://github.com/g4-api/g4-vscode-extension.git"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished",
        "onWebviewPanel:g4-autonomous",
        "onWebviewPanel:g4-flow-publisher",
        "onWebviewPanel:g4-settings",
        "onWebviewPanel:g4-template-publisher"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": true
        }
    },
    "license": "Apache-2.0",
    "main": "./dist/extension.js",
    "contributes": {
        "configuration": {
            "title": "%configuration.title%",
            "properties": {
                "g4.eventLogDetail": {
                    "type": "string",
                    "default": "preview",
                    "enum": [
                        "summary",
                        "preview",
                        "full"
                    ],
                    "enumDescriptions": [
                        "One summary line per event, with no JSON.",
                        "The summary and a shortened view of the JSON: two levels in full, deeper parts as one-line markers, long strings and arrays cut, at most 40 lines.",
                        "The summary and the complete JSON, indented."
                    ],
                    "markdownDescription": "%setting.g4.eventLogDetail.markdownDescription%"
                },
                "g4.sidePanelIcon": {
                    "type": "string",
                    "default": "",
                    "scope": "machine",
                    "markdownDescription": "Absolute path to an SVG file to show as the side-panel (activity bar) icon, for example `C:/branding/activity.svg` or `~/branding/activity.svg`. Draw it on a 24 by 24 grid in one color (`currentColor`); at most 256 KB. Takes precedence over the icon the Hub branding publishes. VS Code reads the icon at startup, so a change shows from the next start. Leave empty for the Hub icon or the built-in icon."
                }
            }
        },
        "commands": [
            {
                "command": "New-Project",
                "category": "%command.New-Project.category%",
                "title": "%command.New-Project.title%"
            },
            {
                "command": "Add-ExampleBots",
                "category": "%command.Add-ExampleBots.category%",
                "title": "%command.Add-ExampleBots.title%"
            },
            {
                "command": "Show-Report",
                "category": "%command.Show-Report.category%",
                "title": "%command.Show-Report.title%"
            },
            {
                "command": "Show-EventJson",
                "category": "%command.Show-EventJson.category%",
                "title": "Show Event JSON"
            },
            {
                "command": "Show-Workflow",
                "category": "%command.Show-Workflow.category%",
                "title": "%command.Show-Workflow.title%"
            },
            {
                "command": "Show-Settings",
                "category": "%command.Show-Settings.category%",
                "title": "Open Settings Editor"
            },
            {
                "command": "Show-Autonomous",
                "category": "%command.Show-Autonomous.category%",
                "title": "Start Autonomous Exploratory Run"
            },
            {
                "command": "Apply-Settings",
                "category": "%command.Apply-Settings.category%",
                "title": "Apply Settings"
            },
            {
                "command": "Open-Bot-As-Json",
                "category": "%command.Open-Bot-As-Json.category%",
                "title": "Open as JSON"
            },
            {
                "command": "Open-Bot-In-Workflow",
                "category": "%command.Open-Bot-In-Workflow.category%",
                "title": "Open in Workflow Editor"
            },
            {
                "command": "Sync-Cache",
                "category": "%command.Sync-Cache.category%",
                "title": "%command.Sync-Cache.title%"
            },
            {
                "command": "Update-Documents",
                "category": "%command.Update-Documents.category%",
                "title": "Fetch latest documents version & refresh documentation"
            },
            {
                "command": "Update-Environment",
                "category": "%command.Update-Environment.category%",
                "title": "Update or Create Environment Variables"
            },
            {
                "command": "Update-Template",
                "category": "%command.Update-Template.category%",
                "title": "Update or Create Template Definitions"
            },
            {
                "command": "Update-Flow",
                "category": "%command.Update-Flow.category%",
                "title": "Open in Flow Publisher"
            },
            {
                "command": "Open-Template-Publisher",
                "category": "%command.Open-Template-Publisher.category%",
                "title": "Open in Template Publisher"
            },
            {
                "command": "Open-Report-Viewer",
                "category": "%command.Open-Report-Viewer.category%",
                "title": "Open in Report Viewer"
            }
        ],
        "grammars": [
            {
                "language": "g4log",
                "scopeName": "source.g4.log",
                "path": "./languages/g4-log-tm-language.json"
            }
        ],
        "languages": [
            {
                "id": "g4log",
                "aliases": [
                    "G4Log",
                    "g4Log"
                ],
                "extensions": []
            }
        ],
        "views": {
            "g4Container": [
                {
                    "type": "webview",
                    "id": "g4View",
                    "name": "Engine Client",
                    "icon": "resources.assets/g4-icon.svg"
                },
                {
                    "type": "webview",
                    "id": "g4RecorderView",
                    "name": "%view.g4RecorderView.name%",
                    "icon": "resources.assets/g4-icon.svg"
                },
                {
                    "type": "tree",
                    "id": "g4Documentations",
                    "name": "%view.g4Documentations.name%",
                    "icon": "resources.assets/g4-documents-icon.svg"
                },
                {
                    "type": "tree",
                    "id": "g4BotsManager",
                    "name": "%view.g4BotsManager.name%",
                    "icon": "resources.assets/g4-bots-icon.svg",
                    "when": "false"
                }
            ]
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "g4Container",
                    "title": "%viewsContainer.g4Container.title%",
                    "icon": "resources.assets/g4-icon.svg"
                }
            ]
        },
        "menus": {
            "explorer/context": [
                {
                    "command": "Open-Bot-As-Json",
                    "group": "navigation",
                    "when": "resourceScheme == file && !explorerResourceIsFolder && resourceExtname =~ /\\.(g4|g4bot)$/i && resourceDirname =~ /(^|[\\\\/])bots([\\\\/]|$)/i"
                },
                {
                    "command": "Open-Bot-In-Workflow",
                    "group": "navigation@1",
                    "when": "resourceScheme == file && !explorerResourceIsFolder && resourceExtname == .json && resourceDirname =~ /(^|[\\\\/])bots([\\\\/]|$)/i"
                },
                {
                    "command": "Open-Bot-In-Workflow",
                    "group": "navigation@1",
                    "when": "resourceScheme == file && !explorerResourceIsFolder && resourceExtname == .json && resourceDirname =~ /(^|[\\\\/])base\\.bots([\\\\/]|$)/i"
                },
                {
                    "command": "Update-Flow",
                    "group": "navigation@2",
                    "when": "resourceScheme == file && !explorerResourceIsFolder && resourceExtname == .json && resourceDirname =~ /(^|[\\\\/])bots([\\\\/]|$)/i"
                },
                {
                    "command": "Open-Template-Publisher",
                    "group": "navigation@3",
                    "when": "resourceScheme == file && !explorerResourceIsFolder && resourceExtname == .json && resourceDirname =~ /(^|[\\\\/])bots([\\\\/]|$)/i"
                },
                {
                    "command": "Open-Template-Publisher",
                    "group": "navigation@1",
                    "when": "resourceScheme == file && !explorerResourceIsFolder && resourceExtname == .json && resourceDirname =~ /(^|[\\\\/])templates([\\\\/]|$)/i"
                },
                {
                    "command": "Show-Settings",
                    "group": "navigation",
                    "when": "resourceScheme == file && !explorerResourceIsFolder && resourceFilename == manifest.json"
                },
                {
                    "command": "Open-Report-Viewer",
                    "group": "navigation@1",
                    "when": "resourceScheme == file && !explorerResourceIsFolder && resourceExtname == .g4rpt && resourcePath in g4.reportFiles"
                },
                {
                    "command": "Add-ExampleBots",
                    "group": "navigation@4",
                    "when": "resourceScheme == file && explorerResourceIsFolder && resourceFilename =~ /^(bots|examples)$/i"
                }
            ],
            "commandPalette": [
                {
                    "command": "Open-Bot-As-Json",
                    "when": "false"
                },
                {
                    "command": "Open-Bot-In-Workflow",
                    "when": "false"
                },
                {
                    "command": "Update-Flow",
                    "when": "false"
                },
                {
                    "command": "Open-Template-Publisher",
                    "when": "false"
                },
                {
                    "command": "Open-Report-Viewer",
                    "when": "false"
                }
            ]
        },
        "customEditors": [
            {
                "viewType": "g4.workflowEditor",
                "displayName": "%customEditor.g4.workflowEditor.displayName%",
                "selector": [
                    {
                        "filenamePattern": "**/bots/*.g4"
                    },
                    {
                        "filenamePattern": "**/bots/**/*.g4"
                    },
                    {
                        "filenamePattern": "**/bots/*.g4bot"
                    },
                    {
                        "filenamePattern": "**/bots/**/*.g4bot"
                    }
                ],
                "priority": "default"
            },
            {
                "viewType": "g4.reportViewer",
                "displayName": "%customEditor.g4.reportViewer.displayName%",
                "selector": [
                    {
                        "filenamePattern": "**/reports/**/*.g4rpt"
                    }
                ],
                "priority": "default"
            }
        ]
    },
    "readme": "README.md",
    "licenses": [
        {
            "path": "LICENSE",
            "type": "Apache-2.0"
        }
    ],
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "webpack",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool hidden-source-map",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "lint": "eslint src",
        "test": "vscode-test",
        "test:unit": "tsc -p tsconfig.test.json && mocha --require out/test/unit/vscode-stub.js \"out/test/unit/**/*.test.js\"",
        "rebuild:electron": "npx @electron/rebuild -f -w uiohook-napi -v 37.2.3"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "20.x",
        "@types/vscode": "^1.102.0",
        "@typescript-eslint/eslint-plugin": "^8.31.1",
        "@typescript-eslint/parser": "^8.31.1",
        "@vscode/test-cli": "^0.0.11",
        "@vscode/test-electron": "^2.5.2",
        "eslint": "^9.25.1",
        "ts-loader": "^9.5.2",
        "typescript": "^5.8.3",
        "webpack": "^5.99.7",
        "webpack-cli": "^6.0.1"
    },
    "files": [
        "resources.assets/**",
        "resources.autonomous/**",
        "resources.base/**",
        "resources.branding/**",
        "resources.components/**",
        "resources.docs/**",
        "resources.examples/**",
        "languages/**",
        "dist/**",
        "node_modules/**",
        "LICENSE",
        "package.nls.json",
        "README.md"
    ],
    "dependencies": {
        "@microsoft/signalr": "^8.0.7",
        "node-fetch": "^3.3.2",
        "uiohook-napi": "^1.5.4"
    }
}
