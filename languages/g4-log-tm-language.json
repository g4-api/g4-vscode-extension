{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "G4Logger",
    "patterns": [
        {
            "include": "#json"
        },
        {
            "include": "#keywords"
        }
    ],
    "repository": {
        "keywords": {
            "patterns": [
                {
                    "name": "markup.heading",
                    "match": "^(\\w+)(\\s+)?(?=:)"
                },
                {
                    "name": "entity.name.class",
                    "match": "(?<=\\s+)(\\w+\\.)+(\\w+Exception)"
                },
                {
                    "name": "invalid",
                    "match": "^(-{3}>)|(?<=((?<=\\s+)(\\w+\\.)+(\\w+Exception:\\s+))).*"
                },
                {
                    "name": "invalid",
                    "match": "☢ [Ee][Rr][Rr][Oo][Rr]|☢"
                },
                {
                    "name": "constant.character",
                    "match": "🛈"
                },
                {
                    "name": "invalid",
                    "match": "⚠"
                },
                {
                    "name": "comment.line",
                    "match": "^#.*"
                },
                {
                    "name": "entity.name.function",
                    "match": "(?<=message:\\s+\\[)(.*?(?=]+\\W+?))"
                },
                {
                    "name": "string.quoted",
                    "match": "(?<=(element)(\\s+\\[))[^;\\s]*(?=\\])|(?<=(argument)(\\s+\\[)).*(?=\\])"
                }
            ]
        },
        "json": {
            "comment": "A JSON line under a log entry: indented by two or more spaces and starting the way JSON does. Each line is matched on its own, so a shortened or cut block can never leak its colors into the next entry.",
            "begin": "^(?=\\s{2,}(?:[\\[\\]{}\"…\\d-]|(?:true|false|null)\\b))",
            "end": "$",
            "patterns": [
                {
                    "name": "comment.line.g4log.json-marker",
                    "match": "[{\\[]…[\\d,]+ (?:keys?|items?)[}\\]]"
                },
                {
                    "name": "comment.line.g4log.json-marker",
                    "match": "\\(\\+[\\d,]+ chars?\\)"
                },
                {
                    "name": "comment.line.g4log.json-marker",
                    "match": "^\\s*… .*$"
                },
                {
                    "name": "support.type.property-name.json",
                    "match": "\"(?:[^\"\\\\]|\\\\.)*\"(?=\\s*:)"
                },
                {
                    "name": "string.quoted.double.json",
                    "match": "\"(?:[^\"\\\\]|\\\\.)*\""
                },
                {
                    "name": "constant.numeric.json",
                    "match": "-?\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b"
                },
                {
                    "name": "constant.language.json",
                    "match": "\\b(?:true|false|null)\\b"
                }
            ]
        }
    },
    "scopeName": "source.g4.log"
}
